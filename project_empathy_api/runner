    "import urllib.request\n",
    "import json\n",
    "import chromadb\n",
    "from tqdm import tqdm\n",
    "\n",
    "# 1. Fetch the data\n",
    "url = \"https://raw.githubusercontent.com/thu-coai/Emotional-Support-Conversation/main/ESConv.json\"\n",
    "response = urllib.request.urlopen(url)\n",
    "raw_data = json.loads(response.read().decode('utf-8'))\n",
    "\n",
    "# 2. Connect to DB\n",
    "db_path = \"/content/drive/MyDrive/project_empathy_api/models/chroma_db\"\n",
    "client = chromadb.PersistentClient(path=db_path)\n",
    "\n",
    "try:\n",
    "    client.delete_collection(name=\"esconv_strategies\")\n",
    "    print(\"Deleted old database.\")\n",
    "except:\n",
    "    pass\n",
    "\n",
    "collection = client.create_collection(name=\"esconv_strategies\", metadata={\"hnsw:space\": \"cosine\"})\n",
    "\n",
    "# 3. Process with NESTED Strategy Extraction\n",
    "documents, metadatas, ids = [], [], []\n",
    "\n",
    "print(\"Extracting strategies from turn['annotation']...\")\n",
    "for i, dialogue in enumerate(raw_data):\n",
    "    convo_text = \"\"\n",
    "    current_strategy = \"Reflection of feelings\" # Base fallback\n",
    "\n",
    "    for turn in dialogue['dialog']:\n",
    "        speaker = turn.get('speaker', 'Unknown').capitalize()\n",
    "        content = turn.get('content', '')\n",
    "        convo_text += f\"{speaker}: {content}\\n\"\n",
    "\n",
    "        # THE NESTED FIX:\n",
    "        # ESConv stores strategy in: turn -> annotation -> strategy\n",
    "        annotation = turn.get('annotation', {})\n",
    "        if isinstance(annotation, dict) and 'strategy' in annotation:\n",
    "            strat = annotation['strategy']\n",
    "            if strat and strat.strip() and strat.lower() != \"others\":\n",
    "                current_strategy = strat\n",
    "\n",
    "    documents.append(convo_text.strip())\n",
    "    metadatas.append({\n",
    "        \"emotion_type\": dialogue.get('emotion_type', 'unknown'),\n",
    "        \"problem_type\": dialogue.get('problem_type', 'unknown'),\n",
    "        \"strategy\": current_strategy\n",
    "    })\n",
    "    ids.append(f\"esconv_{i}\")\n",
    "\n",
    "# 4. Batch Upload\n",
    "batch_size = 100\n",
    "for i in tqdm(range(0, len(documents), batch_size)):\n",
    "    collection.add(\n",
    "        documents=documents[i:i+batch_size],\n",
    "        metadatas=metadatas[i:i+batch_size],\n",
    "        ids=ids[i:i+batch_size]\n",
    "    )\n",
    "\n",
    "print(\"\\n✅ Database rebuilt with NESTED strategies!\")"
   ]
