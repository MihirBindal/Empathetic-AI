    "\n",
    "    # 1. Let's see the REAL keys\n",
    "    print(\"\\nReal Metadata Keys:\")\n",
    "    print(list(raw_data[0].keys()))\n",
    "\n",
    "    # 2. Extract the actual Emotion and Problem categories\n",
    "    emotions = set()\n",
    "    problems = set()\n",
    "\n",
    "    for dialogue in raw_data:\n",
    "        if 'emotion_type' in dialogue:\n",
