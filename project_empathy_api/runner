    "import os\n",
    "import torch\n",
    "from datasets import load_dataset\n",
    "from unsloth import FastLanguageModel\n",
    "from trl import SFTTrainer, SFTConfig\n",
    "from google.colab import drive\n",
    "\n",
    "# ==========================================\n",
    "# 0. MOUNT GOOGLE DRIVE\n",
    "# ==========================================\n",
    "print(\"0. Mounting Google Drive...\")\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "# Updated path to match your project folder structure\n",
    "project_dir = \"/content/drive/MyDrive/project_empathy_api/models\"\n",
    "os.makedirs(project_dir, exist_ok=True)\n",
    "\n",
    "# ==========================================\n",
    "# 1. LOAD MODEL\n",
    "# ==========================================\n",
    "print(\"1. Loading Unsloth Llama-3...\")\n",
    "model, tokenizer = FastLanguageModel.from_pretrained(\n",
    "    model_name     = \"unsloth/llama-3-8b-Instruct-bnb-4bit\",\n",
    "    max_seq_length = 512,\n",
    "    dtype          = torch.float16,\n",
    "    load_in_4bit   = True,\n",
    ")\n",
    "\n",
    "# ==========================================\n",
    "# 2. ATTACH LoRA ADAPTER\n",
    "# ==========================================\n",
    "print(\"2. Attaching LoRA...\")\n",
    "model = FastLanguageModel.get_peft_model(\n",
    "    model,\n",
    "    r                          = 16,\n",
    "    target_modules             = [\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\"],\n",
    "    lora_alpha                 = 32,\n",
    "    lora_dropout               = 0,\n",
    "    bias                       = \"none\",\n",
    "    use_gradient_checkpointing = \"unsloth\",\n",
    ")\n",
    "\n",
    "# ==========================================\n",
    "# 3. FORMAT DATASET\n",
    "# ==========================================\n",
    "print(\"3. Formatting Dataset...\")\n",
    "dataset = load_dataset(\"nbertagnolli/counsel-chat\", split=\"train\")\n",
    "\n",
    "TOPIC_TO_STRATEGY = {\n",
    "    \"depression\":              (\"Reflection of Feelings\",\n",
    "                                \"User is experiencing low mood and needs emotional validation before any advice.\"),\n",
    "    \"anxiety\":                 (\"Reassurance\",\n",
    "                                \"User is overwhelmed and needs calming acknowledgment before solutions.\"),\n",
    "    \"relationships\":           (\"Reframing\",\n",
    "                                \"Relationship conflict benefits from seeing the situation from a new perspective.\"),\n",
    "    \"grief\":                   (\"Reflection of Feelings\",\n",
    "                                \"Loss and grief require acknowledgment and presence, not problem solving.\"),\n",
    "    \"trauma\":                  (\"Validation\",\n",
    "                                \"Trauma responses must be normalised non-judgmentally before any exploration.\"),\n",
    "    \"self-harm\":               (\"Validation\",\n",
    "                                \"Non-judgmental acknowledgment is critical; avoid any advice-giving here.\"),\n",
    "    \"parenting\":               (\"Suggestions\",\n",
    "                                \"Practical guidance is appropriate once the user feels heard.\"),\n",
    "    \"family\":                  (\"Reframing\",\n",
    "                                \"Family conflict often benefits from shifting perspective on roles and intent.\"),\n",
    "    \"eating-disorders\":        (\"Validation\",\n",
    "                                \"Body image and eating concerns require careful non-judgmental validation.\"),\n",
    "    \"anger-management\":        (\"Reflection of Feelings\",\n",
    "                                \"Anger often masks deeper hurt; reflecting feelings opens exploration.\"),\n",
    "    \"stress\":                  (\"Reassurance\",\n",
    "                                \"User needs acknowledgment that their stress response is understandable.\"),\n",
    "    \"spirituality\":            (\"Reframing\",\n",
    "                                \"Existential concerns benefit from exploring meaning and perspective.\"),\n",
    "    \"sleep-improvement\":       (\"Suggestions\",\n",
    "                                \"Practical behavioural suggestions are appropriate for sleep concerns.\"),\n",
    "    \"workplace-relationships\": (\"Reframing\",\n",
    "                                \"Workplace conflict benefits from perspective reframing on dynamics.\"),\n",
    "    \"addiction\":               (\"Validation\",\n",
    "                                \"Acknowledge the difficulty of the struggle without judgment first.\"),\n",
    "    \"lgbtq\":                   (\"Validation\",\n",
    "                                \"Identity and acceptance concerns require affirmation and validation.\"),\n",
    "    \"social-relationships\":    (\"Reflection of Feelings\",\n",
    "                                \"Social anxiety and loneliness need emotional acknowledgment first.\"),\n",
    "    \"marriage\":                (\"Reframing\",\n",
    "                                \"Relationship strain benefits from exploring each partner's perspective.\"),\n",
    "    \"military-issues\":         (\"Validation\",\n",
    "                                \"Service-related trauma and adjustment require non-judgmental presence.\"),\n",
    "}\n",
    "\n",
    "DEFAULT_STRATEGY = (\"Reflection of Feelings\",\n",
    "                    \"Reflecting the user's emotional state creates safety before any guidance.\")\n",
    "\n",
    "def format_prompt(example):\n",
    "    topic    = (example.get(\"topic\") or \"\").strip().lower()\n",
    "    strategy, justification = TOPIC_TO_STRATEGY.get(topic, DEFAULT_STRATEGY)\n",
    "\n",
    "    answer   = (example.get(\"answerText\")   or \"\").strip()\n",
    "    question = (example.get(\"questionText\") or \"\").strip()\n",
    "    if not answer or not question or len(answer) < 40:\n",
    "        return {\"text\": \"\"}\n",
    "\n",
    "    formatted_text = f\"\"\"<|begin_of_text|><|start_header_id|>system<|end_header_id|>\n",
    "You are an empathetic, professional therapist. You will be given the user's message, \\\n",
    "their detected emotional state, a recommended therapeutic strategy, and the justification \\\n",
    "for that strategy. Generate a response that follows the strategy and addresses the user's \\\n",
    "emotional state directly. Be concise, warm, and avoid generic advice.<|eot_id|>\\\n",
    "<|start_header_id|>user<|end_header_id|>\n",
    "User message: {question}\n",
    "Detected emotions: {topic}\n",
    "Strategy: {strategy}\n",
    "Justification: {justification}<|eot_id|>\\\n",
    "<|start_header_id|>assistant<|end_header_id|>\n",
    "{answer}<|eot_id|>\"\"\"\n",
    "\n",
    "    return {\"text\": formatted_text}\n",
    "\n",
    "formatted_dataset = dataset.map(format_prompt, remove_columns=dataset.column_names)\n",
    "formatted_dataset = formatted_dataset.filter(lambda x: len(x[\"text\"]) > 50)\n",
    "print(f\"Training on {len(formatted_dataset)} examples after quality filtering\")\n",
    "\n",
    "# ==========================================\n",
    "# 4. TRAINING CONFIG\n",
    "# ==========================================\n",
    "print(\"4. Initializing Trainer...\")\n",
    "training_args = SFTConfig(\n",
    "    output_dir                  = project_dir,\n",
    "    per_device_train_batch_size = 2,\n",
    "    gradient_accumulation_steps = 4,\n",
    "    optim                       = \"adamw_8bit\",\n",
    "    save_steps                  = 100,\n",
    "    logging_steps               = 20,\n",
    "    learning_rate               = 2e-4,\n",
    "    max_steps                   = 1000,\n",
    "    fp16                        = True,\n",
    "    bf16                        = False,\n",
    "    max_grad_norm               = 0.3,\n",
    "    warmup_steps                = 50,\n",
    "    lr_scheduler_type           = \"cosine\",\n",
    "    dataset_text_field          = \"text\",\n",
    "    max_length                  = 512,\n",
    "    packing                     = False,\n",
    ")\n",
    "\n",
    "trainer = SFTTrainer(\n",
    "    model              = model,\n",
    "    train_dataset      = formatted_dataset,\n",
    "    args               = training_args,\n",
    "    processing_class   = tokenizer,\n",
    ")\n",
    "\n",
    "# ==========================================\n",
    "# CHECK WHAT CHECKPOINT WE ARE RESUMING FROM\n",
    "# ==========================================\n",
    "checkpoints = [\n",
    "    d for d in os.listdir(project_dir)\n",
    "    if d.startswith(\"checkpoint-\")\n",
    "]\n",
    "\n",
    "if checkpoints:\n",
    "    latest = max(checkpoints, key=lambda x: int(x.split(\"-\")[-1]))\n",
    "    print(f\"Resuming from {latest}...\")\n",
    "    trainer.train(resume_from_checkpoint=True)\n",
    "else:\n",
    "    print(\"No checkpoint found — starting fresh...\")\n",
    "    trainer.train()\n",
    "\n",
    "# ==========================================\n",
    "# 5. SAVE ADAPTER\n",
    "# ==========================================\n",
    "print(\"Training complete. Saving adapter...\")\n",
    "model.save_pretrained(project_dir)\n",
    "tokenizer.save_pretrained(project_dir)\n",
    "print(f\"Adapter saved to {project_dir}\")"
   ]
