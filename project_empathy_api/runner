    "import urllib.request\n",
    "import json\n",
    "\n",
    "print(\"=== Bypassing Hugging Face: Fetching Original ESConv JSON ===\")\n",
    "\n",
    "# The original raw JSON hosted by the researchers on GitHub\n",
    "url = \"https://raw.githubusercontent.com/thu-coai/Emotional-Support-Conversation/main/ESConv.json\"\n",
    "\n",
    "try:\n",
    "    # Download the raw file directly\n",
    "    print(\"Downloading raw ESConv.json (this might take a few seconds)...\")\n",
    "    response = urllib.request.urlopen(url)\n",
    "    raw_data = json.loads(response.read().decode('utf-8'))\n",
